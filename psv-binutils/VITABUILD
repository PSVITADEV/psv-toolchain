pkgname=psv-binutils
pkgver=2.43
pkgrel=1
pkgdesc="Binutils and GDB with PS Vita patches applied."
arch=(
  "alpine_x86_64"
  "debian_x86_64"
  "fedora_x86_64"
  "macos_arm64"
  "macos_x86_64"
  "ubuntu_aarch64"
  "ubuntu_x86_64"
)
url="https://github.com/PSVITADEV/psv-binutils-gnu"
license=('GPL-2.0-only')
groups=('psv-toolchain')
depends=()
makedepends=()
optdepends=()
provides=()
source=(${pkgname}::git+https://github.com/PSVITADEV/psv-binutils-gnu.git#commit=968eed953efa038807df7219d35e61d6522ed83d)
sha256sums=("SKIP")

prepare() {
  cd "${pkgname}"

  TARG_XTRA_OPTS=""
  if [ "$(uname -s)" = "Darwin" ]; then
    TARG_XTRA_OPTS="--with-gmp=$(brew --prefix gmp) --with-mpfr=$(brew --prefix mpfr) --with-system-zlib"
  fi

  HOST=""
  if [ "$CARCH" = "alpine_x86_64" ]; then
    HOST="x86_64-pc-linux-musl"
  elif [ "$CARCH" = "debian_x86_64" ]; then
    HOST="x86_64-pc-linux-gnu"
  elif [ "$CARCH" = "fedora_x86_64" ]; then
    HOST="x86_64-pc-linux-gnu"
  elif [ "$CARCH" = "macos_arm64" ]; then
    HOST="arm64-apple-darwin"
  elif [ "$CARCH" = "macos_x86_64" ]; then
    HOST="x86_64-apple-darwin"
  elif [ "$CARCH" = "ubuntu_aarch64" ]; then
    HOST="aarch64-pc-linux-gnu"
  elif [ "$CARCH" = "ubuntu_x86_64" ]; then
    HOST="x86_64-pc-linux-gnu"
  fi

  ./configure \
    --build=$HOST \
    --host=$HOST \
    --target=arm-psv-eabi \
    --prefix="/" \
    --with-sysroot="/psv" \
    --disable-nls \
    --disable-werror \
    --disable-separate-code \
    --enable-interwork \
    --enable-plugins \
    $TARG_XTRA_OPTS
}

build() {
  cd "${pkgname}"
  make INFO_DEPS= DVIS= pdfs= htmls= -j $(getconf _NPROCESSORS_ONLN)
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install

  mkdir -m 755 -p "$pkgdir/share/licenses/$pkgname"
  install -m 644 "COPYING" "$pkgdir/share/licenses/$pkgname"
  install -m 644 "COPYING.LIB" "$pkgdir/share/licenses/$pkgname"
  install -m 644 "COPYING3" "$pkgdir/share/licenses/$pkgname"
  install -m 644 "COPYING3.LIB" "$pkgdir/share/licenses/$pkgname"
  install -m 644 "MAINTAINERS" "$pkgdir/share/licenses/$pkgname"

  rm -f "${pkgdir}/share/info/dir"
}